# Copy this file to .env and fill in your values
# .env is gitignored — never committed

PORT=3000
IPTV_USERNAME=your-username
IPTV_PASSWORD=your-password
IPTV_SERVER=http://your-iptv-server:8080

# Redis (optional — app works without it, just no L2 cache)
REDIS_URL=redis://localhost:6379

# Export directory for server-mode video export (no native dialog in browser)
EXPORT_DIR=./exports

# TMDB API key for ratings/metadata (free: https://www.themoviedb.org/settings/api)
TMDB_API_KEY=your-tmdb-api-key

# Auto-delete watched episodes from cache after X days (default: 3)
WATCHED_RETENTION_DAYS=3
