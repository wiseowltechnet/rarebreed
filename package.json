{
  "name": "rarebreed",
  "version": "0.1.0",
  "description": "IPTV streaming player",
  "type": "module",
  "main": "dist/electron/main.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "start:electron": "electron .",
    "dev": "tsx watch --env-file=.env src/server.ts",
    "dev:electron": "pnpm build && electron .",
    "dist": "electron-builder",
    "lint": "eslint src/",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "audit": "pnpm audit --audit-level=moderate",
    "arch": "depcruise src/ --config .dependency-cruiser.cjs",
    "check": "pnpm lint && pnpm format:check && pnpm arch && pnpm audit",
    "test": "vitest run --exclude 'tests/browser/**'",
    "test:browser": "playwright test",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,yml,yaml,md,html,css}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.0",
    "@fastify/cors": "^11.3.0",
    "@fastify/formbody": "^8.0.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/static": "^10.1.3",
    "@fastify/swagger": "^9.8.1",
    "@fastify/swagger-ui": "^6.1.1",
    "fastify": "^5.1.0",
    "ioredis": "^6.0.0",
    "lru-cache": "^11.5.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.0.0",
    "dependency-cruiser": "^18.2.0",
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsdoc": "^64.2.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.9.6",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.11"
  },
  "build": {
    "appId": "com.rarebreed.player",
    "productName": "RareBreed Player",
    "copyright": "Copyright 2026 RareBreed",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "public/**/*",
      "node_modules/**/*",
      "!node_modules/.pnpm/**/*",
      "!**/*.ts",
      "!**/*.map"
    ],
    "extraResources": [
      {
        "from": ".env.example",
        "to": ".env.example"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
